{
  "name": "shirouto-henshuu-app",
  "version": "1.0.1",
  "description": "素人が作った編集アプリ",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.shirouto.henshuuapp",
    "productName": "ShiroutoHenshuuApp",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "24.13.3"
  }
}
